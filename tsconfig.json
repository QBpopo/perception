{
	"compilerOptions": {
		"target": "es2023",
		"module": "esnext",
		"lib": [ "ES2023", "DOM" ],
		"types": [ "vite/client" ],
		"allowArbitraryExtensions": true,
		"skipLibCheck": true,

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,

		/* Linting */
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true,

		"paths": {
			"@/types": [ "./src/types.ts" ],
			"@/math": [ "./src/math/math.ts" ],
			"@/math/*": [ "./src/math/*.ts" ],
			"@/geometry": [ "./src/math/geometry/geometry.ts" ],
			"@/geometry/*": [ "./src/math/geometry/*.ts" ],
		}
	},
	"include": [ "src" ]
}
